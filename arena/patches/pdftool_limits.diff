+Guard rails: a PDF bigger than 100 MiB (or more pages than --max-pages) is
+skipped with a message instead of being parsed, rendered or merged.  `info` is
+exempt — it is the command you use to find out what is too big.
+
+    pdftool.py text huge.pdf                 -> "skipped: 412.0 MiB > 100.0 MiB limit"
+    pdftool.py text . --max-size 500M        -> raise the limit
+    pdftool.py text . --no-max-size          -> no limit at all
+    pdftool.py text . --max-pages 500        -> also skip long documents
+
 Common flags: -n/--dry-run · --backup · -q/-v · --json · --exclude GLOB
+Limits:       --max-size 100M (K/M/G, 0 or --no-max-size = off) · --max-pages N
 
 Exit codes: 0 ok · 1 errors · 2 usage · 130 interrupted
 """
@@ -53,9 +63,28 @@ TEXT_ENGINES = ("fitz", "pypdf", "pdfminer", "plumber", "pypdf2", "poppler", "oc
 IMAGE_ENGINES = ("fitz", "poppler")
 SHRINK_ENGINES = ("gs", "qpdf", "mutool")
 
+DEFAULT_MAX_SIZE = 100 * (1 << 20)   # 100 MiB: one runaway PDF must not eat a batch
+SIZE_UNITS = {"": 1, "k": 1 << 10, "m": 1 << 20, "g": 1 << 30, "t": 1 << 40}
+SIZE_RE = re.compile(r"^(?P<value>\d+(?:\.\d+)?)\s*(?P<unit>[kmgt]?)(?:i?b)?$", re.IGNORECASE)
+
 _PROBE: dict[str, object | None] = {}
 
 
+class Skipped(Exception):
+    """The file is valid but deliberately not processed (size or page limit)."""
+
+
+def parse_size(text: str) -> int:
+    """``100M`` -> 104857600; ``1.5G``, ``4096K``, ``512`` (bytes) and ``0`` also work."""
+    raw = str(text).strip()
+    if raw.lower() in ("0", "none", "off", "unlimited"):
+        return 0
+    match = SIZE_RE.match(raw)
+    if match is None:
+        raise argparse.ArgumentTypeError(f"bad size {text!r}: use 100M, 1.5G, 4096K or bytes")
+    return int(float(match.group("value")) * SIZE_UNITS[match.group("unit").lower()])
+
+
 def probe(name: str) -> object | None:
     if name not in _PROBE:
         module: object | None = None
